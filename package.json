{
  "name": "@mimir-stellar/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram notifier for Mimir's Soroban contracts on Stellar Testnet: polls mimir-market and mimir-squad events and posts them to a chat.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "node init && tsx watch src/index.ts",
    "start": "node init && node dist/index.js",
    "build": "node init && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/format.test.mjs",
    "scan": "tsx src/stellar/events.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
